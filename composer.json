{
  "name": "pocketcloud/cloud",
  "description": "A cloud system for pocketmine users with proxy support written in PHP",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.4",
    "php-64bit": "*",
    "ext-zip": "*",
    "ext-pmmpthread": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-pcntl": "*",
    "ext-yaml": "*",
    "ext-date": "*",
    "ext-zlib": ">=1.2.11",
    "ext-sockets": "*",
    "ext-reflection": "*",
    "ext-phar": "*",
    "ext-pcre": "*",
    "ext-json": "*",
    "ext-spl": "*",
    "ext-igbinary": "^3.0.1"
  },
  "autoload": {
    "psr-4": {
      "pocketcloud\\cloud\\": "src/"
    }
  },
  "scripts": {
    "build-cloud": [
      "@composer install --no-dev --classmap-authoritative --ignore-platform-reqs",
      "@php -dphar.readonly=0 script/build.php --cloud"
    ],
    "build-bridge-server": [
      "@php -dphar.readonly=0 script/build.php --bridge-server"
    ],
    "build-cloud-bridge-server": [
      "@composer install --no-dev --classmap-authoritative --ignore-platform-reqs",
      "@php -dphar.readonly=0 script/build.php --cloud --bridge-server"
    ]
  }
}